# Server
NODE_ENV=development                 # set to "production" when deploying
PORT=5000
# Set to "true" to disable node-cron scheduled jobs (monthly reports, alerts).
# Useful in CI/tests or when a separate worker owns the schedule.
DISABLE_CRON=false
# Frontend origin(s) allowed by CORS. Comma-separate to allow more than one,
# e.g. https://fintrack.in,https://www.fintrack.in
FRONTEND_URL=http://localhost:5173

# Database (Neon PostgreSQL)
# DATABASE_URL = pooled connection (used by the app at runtime).
# DIRECT_URL   = direct/non-pooled connection (used by Prisma migrations).
#   With no separate pooled URL, set DIRECT_URL equal to DATABASE_URL.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# Redis is optional for local development; leave blank to use the in-memory fallback.
# Set a real Redis URL for multi-instance production deployments.
REDIS_URL=

# JWT
JWT_ACCESS_SECRET=replace_with_64_char_random_secret
JWT_REFRESH_SECRET=replace_with_another_64_char_random_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Groq AI (Get a key from console.groq.com)
# openai/gpt-oss-120b replaces the retired llama-3.3-70b-versatile model.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Cloudinary (recommended for production uploads; otherwise local storage is used in development)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional persistent local storage directory. In production, set this only to a persistent disk.
# UPLOAD_DIR=/var/data/fintrack-uploads

# Email (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@fintrack.in

# Monitoring
SENTRY_DSN=

# Admin: set a unique random secret (32+ chars) before bootstrapping the first admin.
ADMIN_SECRET_KEY=

# WhatsApp bot (Baileys). Set to true, then scan the terminal QR on first boot.
# Users are linked by matching their WhatsApp number to User.phone.
#
# Keep this FALSE on serverless/managed hosts (Railway, Render, Vercel): it needs
# terminal access to scan the QR, and a PERSISTENT disk for the session at
# ./auth_info_baileys — otherwise it re-prompts for QR on every restart.
# Enable only on a long-running self-hosted server (or the docker-compose stack,
# which persists the session in the `wa_auth` volume).
WHATSAPP_ENABLED=false
